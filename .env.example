# Bitrix24 incoming webhook and API
BITRIX_DOMAIN=your-domain.bitrix24.ru
BITRIX_WEBHOOK_USER_ID=123
BITRIX_WEBHOOK_TOKEN=your_webhook_token

# Bot registration config
BITRIX_BOT_TOKEN=your_bot_token # Random string
BITRIX_BOT_CODE=abss_demo_bot
BITRIX_BOT_NAME=ABSS Demo Bot
BITRIX_BOT_WORK_POSITION=ABSS Demo Bot

# Registered bot runtime config
BITRIX_BOT_ID=12345
BITRIX_BOT_TYPE=personal
BITRIX_EVENT_TYPES=message,command
BITRIX_EVENT_TYPE=message
BITRIX_POLLING_TIMEOUT=25
BITRIX_POLLING_LIMIT=100
BITRIX_POLLING_SLEEP_SECONDS=1.0
BITRIX_NOTIFY_ON_START=true
BITRIX_STARTUP_NOTIFY_DIALOG_ID=123
BITRIX_STARTUP_MESSAGE=Бот запущен и готов к работе
BITRIX_SKIP_BACKLOG_ON_START=true
