# Скопируй в `.env` (локально) или `.env.prod` и заполни значения.
# Секреты сюда не коммить. URL входящего webhook:
#   https://<BITRIX_DOMAIN>/rest/<BITRIX_WEBHOOK_USER_ID>/<BITRIX_WEBHOOK_TOKEN>/

# ---------------------------------------------------------------------------
# Incoming webhook (обязательно для всех команд)
# ---------------------------------------------------------------------------
# Домен портала без https:// (пример: company.bitrix24.ru)
BITRIX_DOMAIN=your-domain.bitrix24.ru
# user_id из URL входящего webhook (Разработчикам → Входящий вебхук)
BITRIX_WEBHOOK_USER_ID=123
# секретный токен из того же URL
BITRIX_WEBHOOK_TOKEN=your_webhook_token

# ---------------------------------------------------------------------------
# Регистрация бота — uv run bitrix-register-bot (imbot.v2.Bot.register)
# ---------------------------------------------------------------------------
# Секрет бота: задай сам заранее (любая случайная строка). Нужен во всех imbot.v2.*
BITRIX_BOT_TOKEN=your_bot_token
# Уникальный код бота на портале (default в коде: support_bot)
BITRIX_BOT_CODE=demo_bot
# Отображаемое имя (default: Support Bot)
BITRIX_BOT_NAME=Demo Bot
# Подпись/должность в карточке (default: AI Assistant)
BITRIX_BOT_WORK_POSITION=Demo Bot
# Тип бота: personal = внутренний для сотрудников (default: personal)
BITRIX_BOT_TYPE=personal

# ---------------------------------------------------------------------------
# Runtime — uv run bitrix-bot (после регистрации)
# Удаление — uv run bitrix-unregister-bot
# ---------------------------------------------------------------------------
# ID из ответа register (поле botId). Без него runtime/unregister не стартуют.
BITRIX_BOT_ID=12345

# Типы событий для fetch/polling. Рекомендуемо: message,command
# (если пусто — код берёт message,command)
BITRIX_EVENT_TYPES=message,command
# Fallback на один тип, если BITRIX_EVENT_TYPES пуст (default: message)
BITRIX_EVENT_TYPE=message

# imbot.v2.Event.get: long-poll timeout (сек), лимит событий, пауза между циклами
BITRIX_POLLING_TIMEOUT=25
BITRIX_POLLING_LIMIT=100
BITRIX_POLLING_SLEEP_SECONDS=1.0

# Стартовое уведомление в чат (true/false/1/0/yes/no)
BITRIX_NOTIFY_ON_START=true
# dialogId получателя (часто = user id вебхука / личный чат)
BITRIX_STARTUP_NOTIFY_DIALOG_ID=123
BITRIX_STARTUP_MESSAGE=Бот запущен и готов к работе
# true = при старте сдвинуть offset и не обрабатывать backlog из очереди
BITRIX_SKIP_BACKLOG_ON_START=true
